# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/

# Source archives produced by `git archive` for sharing a snapshot. Regenerate rather than commit.
/aedifex-*.zip
build/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.audit-requirements.txt
htmlcov/

# Environment: never commit real credentials
.env
.env.*
!.env.example

# Collected data. The corpus lives in object storage, not in git; the directory structure is
# kept via .gitkeep files so a clean checkout has somewhere to write.
data/raw/*
data/processed/*
data/normalized/*
data/synthetic/*
data/labels/*
!data/**/.gitkeep

# Semgrep self-test report, written by CI and by anyone reproducing the SAST gate locally.
selftest.json

# India Acquisition Runner: per-run logs and the staging directory the bundle is built in. Both are
# outputs of a run on an operator's machine, not source.
logs/
.india-bundle/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code local settings: contains machine-absolute paths and a personal
# contact address, so it is local configuration rather than shared project config.
.claude/
