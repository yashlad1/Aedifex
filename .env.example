# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
#
# Every value here is a development placeholder. The application refuses to start with
# AEDIFEX_ENVIRONMENT=production while any of them are still in place, so a production
# deployment must supply real values from a secret manager (AWS Secrets Manager) rather than
# from a file.
#
# An unrecognised AEDIFEX_* variable is a hard error, not a warning: a typo would otherwise
# silently leave the default in place.

AEDIFEX_ENVIRONMENT=development
AEDIFEX_DEBUG=false

# --- Database ---------------------------------------------------------------
# Host is `localhost` for running the API on the host against docker compose, and `postgres`
# when running the API inside compose.
AEDIFEX_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aedifex
AEDIFEX_DATABASE_POOL_SIZE=5
AEDIFEX_DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# --- Object storage ---------------------------------------------------------
# Leave the endpoint unset in production to use AWS S3, and prefer an IAM role over keys.
AEDIFEX_STORAGE_ENDPOINT_URL=http://localhost:9000
AEDIFEX_STORAGE_BUCKET=aedifex-dev
AEDIFEX_STORAGE_REGION=us-east-1
AEDIFEX_STORAGE_ACCESS_KEY_ID=minioadmin
AEDIFEX_STORAGE_SECRET_ACCESS_KEY=minioadmin

# --- Source registry --------------------------------------------------------
AEDIFEX_SOURCE_REGISTRY_DIR=config/sources

# --- Acquisition limits -----------------------------------------------------
# Hard ceilings applied to untrusted remote content. 256 MiB.
AEDIFEX_MAX_DOWNLOAD_BYTES=268435456
AEDIFEX_REQUEST_TIMEOUT_SECONDS=30
# Must contain a contact URL or email so site operators can reach us about crawler traffic.
AEDIFEX_USER_AGENT=AedifexBot/0.1 (+https://example.invalid/bot; contact: ops@example.invalid)

# --- Observability ----------------------------------------------------------
# `console` is readable locally; `json` is required anywhere logs are aggregated.
AEDIFEX_LOG_LEVEL=INFO
AEDIFEX_LOG_FORMAT=console
